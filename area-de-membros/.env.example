# URL pública do app (sem barra no final). Ex.: https://academia.suaempresa.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nome do app (aparece no topo, nos e-mails e no certificado)
NEXT_PUBLIC_SITE_NAME=Academia Minha Empresa
NEXT_PUBLIC_COMPANY_NAME=Minha Empresa
# (opcional) logo redondo do topo e link de suporte (ex.: WhatsApp do RH)
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_SUPPORT_URL=
# Quem assina o certificado
NEXT_PUBLIC_CERT_SIGNER=Nome da pessoa do RH
NEXT_PUBLIC_CERT_SIGNER_TITLE=Gerente de RH

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha no navegador. Usada só no servidor para convidar colaboradores.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys (o remetente precisa ser de um domínio verificado)
RESEND_API_KEY=
EMAIL_FROM="Academia Minha Empresa <academia@suaempresa.com.br>"
