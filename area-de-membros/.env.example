# URL pública do app (sem barra no final). Ex.: https://academia.pestx.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Academia PestX
# (opcional) logo do topo quando a empresa não tem logo, e link de suporte
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_SUPPORT_URL=

# Neon → Connect → copie a "Connection string" COM "Connection pooling" ligado (host com -pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Chave secreta para preparar o banco em /primeiro-acesso (mínimo 12 caracteres)
SETUP_KEY=troque-por-uma-frase-longa

# Login do PestX (somente leitura). A chave anon é a pública do app.pestx.com.br.
# Sem estas duas, o app usa login próprio com uma empresa só.
PESTX_SUPABASE_URL=https://whtpqghzjqshtnraedat.supabase.co
PESTX_SUPABASE_ANON_KEY=

# Arquivos enviados (capas, PDFs, fotos, assinaturas). Na VPS: /opt/academia/arquivos
UPLOAD_DIR=./uploads

# Marketplace: pagamento pelo Asaas (Pix, boleto, cartão)
# ASAAS_ENV: production ou sandbox. ASAAS_WEBHOOK_TOKEN: o mesmo token do webhook no Asaas (mín. 16 caracteres)
ASAAS_API_KEY=
ASAAS_ENV=production
ASAAS_WEBHOOK_TOKEN=

# Resend → API Keys (o remetente precisa ser de um domínio verificado)
RESEND_API_KEY=
EMAIL_FROM="Academia PestX <academia@envio.pestx.com.br>"
