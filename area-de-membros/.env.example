# URL pública do site (sem barra no final). Em produção: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Minha Escola

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha esta chave no navegador. Usada só no servidor (webhook e convites).
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM="Minha Escola <acesso@seudominio.com.br>"

# Token secreto do webhook da Appmax. Cadastre na Appmax a URL:
# https://seudominio.com.br/api/webhooks/appmax?token=ESTE_VALOR
APPMAX_WEBHOOK_SECRET=troque-por-um-valor-longo-e-aleatorio
# (opcional) eventos que liberam / removem acesso, separados por vírgula
# APPMAX_GRANT_EVENTS=OrderApproved,OrderPaid,OrderPaidByPix,OrderPaidByBillet
# APPMAX_REVOKE_EVENTS=OrderRefund,OrderChargeBack,OrderChargeback
