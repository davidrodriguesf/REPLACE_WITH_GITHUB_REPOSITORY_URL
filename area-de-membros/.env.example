# URL pública do app (sem barra no final). Ex.: https://academia.suaempresa.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Academia Foco
NEXT_PUBLIC_COMPANY_NAME=Foco Dedetizadora
# (opcional) logo redondo do topo e link de suporte (ex.: WhatsApp do RH)
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_SUPPORT_URL=
# Quem assina os certificados
NEXT_PUBLIC_CERT_SIGNER=Nome da pessoa responsável
NEXT_PUBLIC_CERT_SIGNER_TITLE=Gerente de RH

# Neon → Connect → copie a "Connection string" COM "Connection pooling" ligado (host com -pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Chave secreta para criar o primeiro administrador em /primeiro-acesso (mínimo 12 caracteres)
SETUP_KEY=troque-por-uma-frase-longa

# Resend → API Keys (o remetente precisa ser de um domínio verificado)
RESEND_API_KEY=
EMAIL_FROM="Academia Foco <academia@seudominio.com.br>"
