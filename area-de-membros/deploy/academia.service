[Unit]
Description=Academia PestX - universidade corporativa (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__BASE__/app
EnvironmentFile=__BASE__/academia.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=__BASE__/node/bin/node __BASE__/app/server.js
Restart=always
RestartSec=5

# só grava no cache do próprio app e na pasta de arquivos enviados
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__BASE__/app/.next/cache __BASE__/arquivos
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
